# SQLite para desarrollo. En producción usar Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/bdap"
DATABASE_URL="file:./dev.db"
PORT=4000
# Obligatoria en producción (el servidor no arranca sin ella con NODE_ENV=production)
JWT_SECRET="change_this_in_production"
# Duración del token (por defecto 7d)
# JWT_EXPIRES_IN="7d"
# Orígenes permitidos para CORS en producción, separados por comas
# CORS_ORIGIN="https://tu-frontend.onrender.com"

# Integraciones externas (opcionales como fallback por defecto del servidor;
# también pueden configurarse por organización desde la interfaz web):
# STRIPE_API_KEY="sk_test_..."
# HUBSPOT_ACCESS_TOKEN="pat-na1-..."
# GA_PROPERTY_ID="123456789"
# GA_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
